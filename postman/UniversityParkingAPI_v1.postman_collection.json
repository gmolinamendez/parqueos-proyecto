              ],
              "path": [
                "api",
                "v1",
                "parking-spots"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.id) {",
                  "  pm.collectionVariables.set('parking_spot_id', String(jsonData.data.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Parking Spot",
          "request": {
