            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"P-A101\",\n  \"zone\": \"A-Updated\",\n  \"is_active\": true,\n  \"is_occupied\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/parking-spots/{{parking_spot_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
