                "parking-spots"
              ]
            }
          }
        },
        {
          "name": "Create Parking Spot (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"P-A101\",\n  \"zone\": \"A\",\n  \"is_active\": true,\n  \"is_occupied\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/parking-spots",
              "host": [
